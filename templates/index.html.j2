<!DOCTYPE html>
<html lang="pl" class="scroll-smooth">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Arch-Ogło — Baza Ogłoszeń Architektonicznych</title>
<meta name="description" content="Codziennie aktualizowana baza przetargów na prace projektowe architektury i dokumentację wielobranżową: TED, BIP spółek skarbu państwa, platformazakupowa.pl.">
<script src="https://cdn.tailwindcss.com"></script>
<style>
  .mesh{position:fixed;inset:0;z-index:-1;pointer-events:none;
    background-image:
      repeating-linear-gradient(115deg, rgba(255,255,255,.035) 0 1px, transparent 1px 42px),
      repeating-linear-gradient(65deg, rgba(255,255,255,.035) 0 1px, transparent 1px 42px),
      radial-gradient(1200px 700px at 85% -10%, rgba(16,185,129,.07), transparent 60%);
  }
  .glow{background:radial-gradient(600px 240px at 20% 0%, rgba(16,185,129,.10), transparent 70%);}
</style>
</head>
<body class="bg-zinc-950 text-zinc-100 antialiased">
<div class="mesh"></div>

<header class="sticky top-0 z-20 backdrop-blur bg-zinc-950/80 border-b border-zinc-800">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between gap-4">
    <a href="index.html" class="flex items-center gap-2 font-semibold tracking-tight text-lg">
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400">▲</span>
      Arch<span class="text-emerald-400">-Ogło</span>
    </a>
    <div class="flex items-center gap-1 overflow-x-auto" id="filters">
      <button data-filter="all"      class="filter-btn px-4 py-1.5 rounded-xl text-sm bg-emerald-500 text-white font-medium">Wszystkie</button>
      <button data-filter="konkurs"  class="filter-btn px-4 py-1.5 rounded-xl text-sm border border-zinc-800 text-zinc-400 hover:text-zinc-100">Konkursy</button>
      <button data-filter="praca"    class="filter-btn px-4 py-1.5 rounded-xl text-sm border border-zinc-800 text-zinc-400 hover:text-zinc-100">Praca</button>
      <button data-filter="przetarg" class="filter-btn px-4 py-1.5 rounded-xl text-sm border border-zinc-800 text-zinc-400 hover:text-zinc-100">Przetargi</button>
      <a href="archiwum.html" class="ml-2 px-4 py-1.5 rounded-xl text-sm border border-zinc-800 text-zinc-400 hover:text-zinc-100 whitespace-nowrap">Archiwum</a>
    </div>
  </div>
</header>

<section class="glow">
  <div class="max-w-6xl mx-auto px-4 pt-14 pb-10">
    <p class="text-emerald-400 text-sm font-medium mb-2">Automatyczny monitoring · TED · BIP · platformazakupowa.pl</p>
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">Baza Ogłoszeń<br class="hidden sm:block"> <span class="text-zinc-400">Architektonicznych</span></h1>
    <p class="mt-4 text-zinc-400 max-w-xl">Przetargi na prace projektowe i dokumentację wielobranżową — zbierane raz dziennie, filtrowane pod profil biura, publikowane automatycznie.</p>
    <div class="mt-8 grid sm:grid-cols-3 gap-4">
      <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-5">
        <div class="text-3xl font-bold text-emerald-400">{{ current|length }}</div>
        <div class="text-zinc-400 text-sm mt-1">aktualnych ogłoszeń</div>
      </div>
      <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-5">
        <div class="text-3xl font-bold">{{ (nearest[0].termin_skladania|default("—"))[:10] if nearest else "—" }}</div>
        <div class="text-zinc-400 text-sm mt-1">najbliższy termin składania</div>
      </div>
      <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-5">
        <a href="https://github.com/matkowpa/arch-oglo#%C5%BAr%C3%B3d%C5%82a" title="Lista źródeł i ich status — README (otwiera GitHub)" class="block group">
          <div class="text-3xl font-bold group-hover:text-emerald-400 transition">{{ n_sources }}</div>
          <div class="text-zinc-400 text-sm mt-1 group-hover:text-zinc-300 transition">{{ sources_word }} · {{ generated }}</div>
        </a>
      </div>
    </div>
  </div>
</section>
{% if failed_sources %}
<section class="max-w-6xl mx-auto px-4 -mt-2">
  <div class="bg-red-500/10 border border-red-500/30 text-red-300 rounded-xl px-4 py-3 text-sm">
    ⚠️ Źródła niedostępne w tym runie: {{ failed_sources|join(", ") }} — wyniki mogą być niepełne.
  </div>
</section>
{% endif %}
<main class="max-w-6xl mx-auto px-4 pb-16 grid lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <h2 class="text-lg font-semibold">Ogłoszenia</h2>
      <input id="q" type="search" placeholder="Szukaj…" autocomplete="off"
             class="bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-2 text-sm w-56 outline-none focus:border-emerald-500/50 placeholder:text-zinc-500">
    </div>
    <div class="flex flex-wrap items-center gap-2 mb-4 text-sm">
      <select id="sort" class="bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2 text-sm outline-none focus:border-emerald-500/50">
        <option value="default">Sortuj: score ↓, termin</option>
        <option value="termin">Sortuj: termin składania ↑</option>
        <option value="score">Sortuj: score malejąco</option>
        <option value="zrodlo">Sortuj: źródło, score ↓</option>
      </select>
      <select id="fscore" class="bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2 text-sm outline-none focus:border-emerald-500/50">
        <option value="all">Score: wszystkie</option>
        <option value="3-4">score 3–4</option>
        <option value="5-6">score 5–6</option>
        <option value="7-999">score 7+</option>
      </select>
      <select id="fsrc" class="bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2 text-sm outline-none focus:border-emerald-500/50">
        <option value="all">Źródło: wszystkie</option>
        {% for s in sources %}<option value="{{ s }}">{{ s }}</option>{% endfor %}
      </select>
      <select id="fadded" class="bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2 text-sm outline-none focus:border-emerald-500/50">
        <option value="all">Dodane: wszystkie</option>
        {% for d in added %}<option value="{{ d.date }}">Dodane: {{ d.label }} ({{ d.count }})</option>{% endfor %}
      </select>
    </div>
    <div id="cards" class="space-y-4">
    {% for a in current %}
    <article class="card bg-zinc-900 border border-zinc-800 rounded-xl p-5 hover:border-emerald-500/40 transition"
             data-category="{{ a.kategoria }}" data-t="{{ (a.tytul ~ ' ' ~ a.zamawiajacy)|lower }}"
             data-source="{{ a.zrodlo }}" data-score="{{ a.score|default(0) }}"
             data-added="{{ (a.dodano or '')[:10] }}"
             data-deadline="{{ (a.termin_skladania or '')[:10] }}">
      <div class="flex items-start justify-between gap-4">
        <div class="min-w-0">
          <span class="inline-block bg-emerald-500/10 text-emerald-400 text-xs px-2.5 py-0.5 rounded-xl border border-emerald-500/20 mb-2">{{ a.kategoria }}</span>
          <h3 class="font-semibold leading-snug">
            <a href="{{ a.url }}" target="_blank" rel="noopener" class="hover:text-emerald-400">{{ a.tytul }}</a>
          </h3>
          <p class="text-zinc-400 text-sm mt-1">{{ a.zamawiajacy|default("—", true) }}</p>
        </div>
        <div class="shrink-0 text-center bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2">
          <div class="text-xl font-bold text-emerald-400">{{ a.score|default("–") }}</div>
          <div class="text-[10px] uppercase tracking-wide text-zinc-500">score</div>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2 mt-3 text-xs">
        {% if a.termin_skladania %}
          {% set d = a.termin_skladania[:10] %}
          <span class="border border-zinc-800 rounded-xl px-2.5 py-1 {% if d <= deadline_7 and d >= generated_date %}text-red-400 border-red-500/30{% elif d <= deadline_14 and d >= generated_date %}text-amber-400 border-amber-500/30{% else %}text-zinc-400{% endif %}">⏳ do {{ d }}</span>
        {% else %}
          <span class="border border-zinc-800 rounded-xl px-2.5 py-1 text-zinc-500">termin: brak</span>
        {% endif %}
        <a class="bg-emerald-500/10 text-emerald-400 px-2.5 py-1 rounded-xl border border-emerald-500/20 hover:border-emerald-500/40" href="https://github.com/matkowpa/arch-oglo#%C5%BAr%C3%B3d%C5%82a" target="_blank" rel="noopener" title="Status źródeł — README (otwiera GitHub)">{{ a.zrodlo }}</a>
        {% for t in a.tagi %}{% if t != "brak-terminu" %}<span class="border border-zinc-800 text-zinc-400 px-2.5 py-1 rounded-xl">{{ t }}</span>{% endif %}{% endfor %}
      </div>
    </article>
    {% else %}
    <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-10 text-center text-zinc-400">Brak ogłoszeń w tej kategorii.</div>
    {% endfor %}
    </div>
    <p id="nores" class="hidden text-center text-zinc-500 py-10">Brak wyników dla wybranego filtra.</p>
  </div>

  <aside>
    <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-5 sticky top-24">
      <h2 class="text-lg font-semibold mb-4 flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span> Pilne terminy
      </h2>
      <ul class="space-y-3">
      {% for a in nearest %}
        <li class="border border-zinc-800 rounded-xl p-4 hover:border-emerald-500/40 transition">
          <div class="text-emerald-400 text-sm font-semibold">{{ a.termin_skladania[:10] }}</div>
          <a href="{{ a.url }}" target="_blank" rel="noopener" class="text-sm text-zinc-300 hover:text-emerald-400 line-clamp-2 mt-1 block">{{ a.tytul }}</a>
          <div class="text-zinc-500 text-xs mt-1">{{ a.zamawiajacy|default("", true)|truncate(40) }}</div>
        </li>
      {% else %}
        <li class="text-zinc-500 text-sm">Brak nadchodzących terminów.</li>
      {% endfor %}
      </ul>
      <div class="mt-5 pt-4 border-t border-zinc-800 text-xs text-zinc-500">
        Aktualizacja: {{ generated }} · okno {{ display_days }} dni
      </div>
    </div>
  </aside>
</main>
<footer class="border-t border-zinc-800">
  <div class="max-w-6xl mx-auto px-4 py-8 flex flex-wrap items-center justify-between gap-3 text-sm text-zinc-500">
    <span class="flex items-center gap-2">
      <span class="inline-flex h-6 w-6 items-center justify-center rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs">▲</span>
      Arch-Ogło — baza ogłoszeń architektonicznych
    </span>
    <span>Źródła: TED · BIP spółek SP · platformazakupowa.pl · <a class="hover:text-emerald-400" href="https://github.com/matkowpa/arch-oglo">GitHub</a></span>
  </div>
</footer>
<script>
// Filtry kategorii (interface.md) + filtry score/źródło + sortowanie (2026-08-30)
const btns = document.querySelectorAll('.filter-btn');
const cardsBox = document.getElementById('cards');
const cards = Array.from(document.querySelectorAll('.card'));
const nores = document.getElementById('nores');
let activeFilter = 'all';
let activeSrc = 'all';
let activeAdded = 'all';
let scoreMin = 0, scoreMax = Infinity;
let sortKey = 'default';
const query = document.getElementById('q');
let q = '';

function apply() {
  let visible = 0;
  cards.forEach(c => {
    const okCat = activeFilter === 'all' || c.dataset.category === activeFilter;
    const okText = !q || c.dataset.t.includes(q);
    const okSrc = activeSrc === 'all' || c.dataset.source === activeSrc;
    const okAdded = activeAdded === 'all' || c.dataset.added === activeAdded;
    const s = parseFloat(c.dataset.score || 0);
    const okScore = s >= scoreMin && s <= scoreMax;
    const show = okCat && okText && okSrc && okAdded && okScore;
    c.classList.toggle('hidden', !show);
    if (show) visible++;
  });
  nores.classList.toggle('hidden', visible > 0);
}

function resort() {
  sortKey = document.getElementById('sort').value;
  const cmp = {
    default:  (a, b) => (+b.dataset.score || 0) - (+a.dataset.score || 0) ||
                        (a.dataset.deadline || '9999').localeCompare(b.dataset.deadline || '9999'),
    termin:   (a, b) => (a.dataset.deadline || '9999').localeCompare(b.dataset.deadline || '9999'),
    score:    (a, b) => (+b.dataset.score || 0) - (+a.dataset.score || 0),
    zrodlo:   (a, b) => (a.dataset.source || '').localeCompare(b.dataset.source || '') ||
                        (+b.dataset.score || 0) - (+a.dataset.score || 0),
  }[sortKey];
  cards.sort(cmp).forEach(c => cardsBox.appendChild(c));
}

const btnsAll = document.querySelectorAll('.filter-btn');
btnsAll.forEach(b => b.addEventListener('click', () => {
  btnsAll.forEach(x => {
    x.classList.remove('bg-emerald-500', 'text-white', 'font-medium');
    x.classList.add('border', 'border-zinc-800', 'text-zinc-400');
  });
  b.classList.add('bg-emerald-500', 'text-white', 'font-medium');
  b.classList.remove('text-zinc-400');
  activeFilter = b.dataset.filter;
  apply();
}));

document.getElementById('sort').addEventListener('change', resort);

document.getElementById('fscore').addEventListener('change', e => {
  if (e.target.value === 'all') { scoreMin = 0; scoreMax = Infinity; }
  else {
    const [lo, hi] = e.target.value.split('-').map(Number);
    scoreMin = lo; scoreMax = hi;
  }
  apply();
});

document.getElementById('fsrc').addEventListener('change', e => {
  activeSrc = e.target.value;
  apply();
});

document.getElementById('fadded').addEventListener('change', e => {
  activeAdded = e.target.value;
  apply();
});

query.addEventListener('input', () => { q = query.value.trim().toLowerCase(); apply(); });
</script>
</body>
</html>