<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Przetargi — prace projektowe i dokumentacja wielobranżowa</title>
<meta name="description" content="Codziennie aktualizowana lista przetargów na prace projektowe architektury i dokumentację wielobranżową: TED, BIP spółek skarbu państwa, platformazakupowa.pl.">
<style>
  :root{
    --bg:#f4f6fa; --card:#ffffff; --ink:#1a2332; --muted:#66738a; --line:#e4e9f1;
    --accent:#2952c3; --accent2:#3b6fe0;
    --good:#e7f6ea; --good-ink:#166534; --warn:#fef3c7; --warn-ink:#92400e;
    --hot:#fee2e2; --hot-ink:#b91c1c; --badge:#eef2fb;
  }
  @media (prefers-color-scheme: dark){
    :root{ --bg:#0f1623; --card:#182238; --ink:#e7ecf5; --muted:#93a0b8; --line:#273350;
      --accent:#7d9bff; --accent2:#5d7ef0; --good:#12301c; --good-ink:#7ee2a0;
      --warn:#33260c; --warn-ink:#f5c15c; --hot:#3b1212; --hot-ink:#ff9d9d; --badge:#1e2a45; }
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);
    font-family:"Segoe UI Variable","Segoe UI",system-ui,-apple-system,Roboto,sans-serif;
    font-size:15px;line-height:1.45}
  header{position:sticky;top:0;z-index:10;color:#fff;
    background:linear-gradient(135deg,#1e3a8a,#2952c3 55%,#3b6fe0);
    box-shadow:0 2px 12px rgba(20,40,90,.25)}
  .hwrap{max-width:1100px;margin:0 auto;padding:18px 20px;display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between}
  h1{font-size:1.12rem;font-weight:600;margin:0;letter-spacing:.01em}
  .stats{display:flex;gap:8px;flex-wrap:wrap}
  .chip{background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.25);
    border-radius:999px;padding:3px 12px;font-size:.78rem;white-space:nowrap}
  nav{max-width:1100px;margin:0 auto;padding:0 20px 12px;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
  nav a{color:#dbe6ff;text-decoration:none;font-size:.85rem;padding:4px 14px;border-radius:999px;
    background:rgba(255,255,255,.12)}
  nav a.on{background:#fff;color:#1e3a8a;font-weight:600}
  .search{flex:1;min-width:200px}
  .search input{width:100%;max-width:340px;padding:6px 14px;border-radius:999px;border:1px solid rgba(255,255,255,.3);
    background:rgba(255,255,255,.14);color:#fff;font-size:.85rem;outline:none}
  .search input::placeholder{color:#c9d6f5}
  main{max-width:1100px;margin:22px auto 40px;padding:0 20px}
  .card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px 18px;margin-bottom:12px;
    display:grid;grid-template-columns:52px 1fr auto;gap:6px 16px;align-items:start;
    box-shadow:0 1px 2px rgba(15,25,50,.06);transition:box-shadow .15s,transform .15s}
  .card:hover{box-shadow:0 4px 16px rgba(15,25,50,.12);transform:translateY(-1px)}
  .score{width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;
    font-weight:700;font-size:1.05rem;background:var(--badge);color:var(--accent)}
  .score.s6{background:var(--good);color:var(--good-ink)}
  .score.s4{background:var(--warn);color:var(--warn-ink)}
  .title{margin:0;font-size:1rem;font-weight:600}
  .title a{color:var(--ink);text-decoration:none}
  .title a:hover{color:var(--accent);text-decoration:underline}
  .who{color:var(--muted);font-size:.85rem;margin-top:1px}
  .meta{grid-column:2;display:flex;flex-wrap:wrap;gap:6px;margin-top:4px}
  .tag{display:inline-block;background:var(--badge);color:var(--accent);border-radius:999px;
    padding:2px 10px;font-size:.73rem;font-weight:500}
  .tag.wysoka-trafnosc{background:var(--good);color:var(--good-ink)}
  .tag.brak-terminu{background:var(--warn);color:var(--warn-ink)}
  .tag.drogi,.tag.sieci{background:var(--hot);color:var(--hot-ink)}
  .src{color:var(--muted);font-size:.75rem;border:1px solid var(--line);border-radius:999px;padding:2px 10px}
  .dl{font-weight:600;font-size:.8rem}
  .dl.hot{color:var(--hot-ink)} .dl.soon{color:var(--warn-ink)} .dl.none{color:var(--muted);font-weight:400}
  .side{grid-column:3;grid-row:1;display:flex;flex-direction:column;align-items:flex-end;gap:4px}
  .failed{background:var(--hot);color:var(--hot-ink);border-radius:10px;padding:8px 14px;margin-bottom:12px;font-size:.85rem}
  .empty{text-align:center;color:var(--muted);padding:48px 0}
  footer{color:var(--muted);font-size:.78rem;text-align:center;padding:20px;border-top:1px solid var(--line)}
  @media(max-width:640px){ .card{grid-template-columns:1fr} .side{grid-column:1;grid-row:auto;flex-direction:row;justify-content:flex-start} }
</style>
</head>
<body>
<header>
  <div class="hwrap">
    <h1>🏗️ Przetargi — prace projektowe / dokumentacja wielobranżowa</h1>
    <div class="stats">
      <span class="chip">📋 {{ current|length }} aktualnych</span>
      <span class="chip">🕒 {{ generated }}</span>
      <span class="chip">↻ codziennie 05:00 UTC</span>
    </div>
  </div>
  <nav>
    <a class="on" href="index.html">Aktualne</a>
    <a href="archiwum.html">Archiwum</a>
    <span class="search"><input id="q" type="search" placeholder="🔍 filtruj: tytuł lub zamawiający…" autocomplete="off"></span>
  </nav>
</header>
<main>
{% if failed_sources %}<div class="failed">⚠️ Źródła zawiodły w tym runie: {{ failed_sources|join(", ") }}</div>{% endif %}
<div id="cards">
{% for a in current %}
<article class="card" data-t="{{ (a.tytul ~ ' ' ~ a.zamawiajacy)|lower }}">
  <div class="score s{{ a.score|default(0) }}">{{ a.score|default("–") }}</div>
  <div>
    <p class="title"><a href="{{ a.url }}" target="_blank" rel="noopener">{{ a.tytul }}</a></p>
    <p class="who">{{ a.zamawiajacy|default("—", true) }}</p>
  </div>
  <div class="side"><span class="src">{{ a.zrodlo }}</span></div>
  <div class="meta">
    {% if a.termin_skladania %}
      {% set d = a.termin_skladania[:10] %}
      <span class="dl {% if d <= deadline_7 and d >= generated_date %}hot{% elif d <= deadline_14 and d >= generated_date %}soon{% endif %}">⏳ do {{ d }}</span>
    {% else %}
      <span class="dl none">termin: brak</span>
    {% endif %}
    {% if a.data_publikacji %}<span class="tag">📅 {{ a.data_publikacji }}</span>{% endif %}
    {% for t in a.tagi %}<span class="tag {{ t }}">{{ t }}</span>{% endfor %}
  </div>
</article>
{% else %}
<div class="empty">Brak aktualnych ogłoszeń w oknie {{ display_days }} dni.</div>
{% endfor %}
</div>
<p id="nores" class="empty" style="display:none">Brak wyników dla podanego filtra.</p>
</main>
<footer>Źródła: TED (zam. unijne), BIP spółek SP, platformazakupowa.pl — pobierane automatycznie raz dziennie.
<a style="color:var(--muted)" href="https://github.com/matkowpa/arch-oglo">Kod i dane</a></footer>
<script>
const q=document.getElementById('q');
q.addEventListener('input',()=>{
  const f=q.value.trim().toLowerCase();let n=0;
  document.querySelectorAll('.card').forEach(c=>{
    const show=!f||c.dataset.t.includes(f);c.style.display=show?'':'none';if(show)n++;
  });
  document.getElementById('nores').style.display=n?'none':'';
});
</script>
</body>
</html>
