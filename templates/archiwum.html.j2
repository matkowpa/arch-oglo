<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Archiwum — Arch-Ogło</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>
  .mesh{position:fixed;inset:0;z-index:-1;pointer-events:none;
    background-image:
      repeating-linear-gradient(115deg, rgba(255,255,255,.03) 0 1px, transparent 1px 42px),
      repeating-linear-gradient(65deg, rgba(255,255,255,.03) 0 1px, transparent 1px 42px);}
</style>
</head>
<body class="bg-zinc-950 text-zinc-100 antialiased">
<div class="mesh"></div>

<header class="sticky top-0 z-20 backdrop-blur bg-zinc-950/80 border-b border-zinc-800">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <a href="index.html" class="flex items-center gap-2 font-semibold text-lg">
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400">▲</span>
      Arch<span class="text-emerald-400">-Ogło</span>
    </a>
    <nav class="flex gap-1">
      <a href="index.html" class="px-4 py-1.5 rounded-xl text-sm border border-zinc-800 text-zinc-400 hover:text-zinc-100">Aktualne</a>
      <a href="archiwum.html" class="px-4 py-1.5 rounded-xl text-sm bg-emerald-500 text-white font-medium">Archiwum</a>
    </nav>
  </div>
</header>

<main class="max-w-6xl mx-auto px-4 py-10">
  <h1 class="text-3xl font-bold tracking-tight">Archiwum <span class="text-zinc-400">ogłoszeń</span></h1>
  <p class="text-zinc-400 mt-2 text-sm">{{ archive|length }} pozycji (historia 90 dni)</p>
  <div class="mt-8 space-y-3">
  {% for a in archive %}
    <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-4 hover:border-emerald-500/40 transition flex flex-wrap items-baseline justify-between gap-3">
      <div class="min-w-0">
        <a href="{{ a.url }}" target="_blank" rel="noopener" class="font-medium hover:text-emerald-400">{{ a.tytul }}</a>
        <div class="text-zinc-500 text-sm mt-0.5">{{ a.zamawiajacy|default("—", true) }}</div>
      </div>
      <div class="text-xs text-zinc-500 flex items-center gap-3">
        <span>{{ a.termin_skladania|default("—", true) }}</span>
        <span class="border border-zinc-800 rounded-xl px-2.5 py-1">score {{ a.score|default("–") }}</span>
        <a class="border border-zinc-800 rounded-xl px-2.5 py-1 hover:border-emerald-500/40" href="https://github.com/matkowpa/arch-oglo#%C5%BAr%C3%B3d%C5%82a" target="_blank" rel="noopener">{{ a.zrodlo }}</a>
      </div>
    </div>
  {% else %}
    <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-10 text-center text-zinc-400">Archiwum jest puste.</div>
  {% endfor %}
  </div>
</main>

<footer class="border-t border-zinc-800">
  <div class="max-w-6xl mx-auto px-4 py-8 text-sm text-zinc-500 flex justify-between flex-wrap gap-3">
    <span>Arch-Ogło — baza ogłoszeń architektonicznych</span>
    <a class="hover:text-emerald-400" href="https://github.com/matkowpa/arch-oglo">GitHub</a>
  </div>
</footer>
</body>
</html>